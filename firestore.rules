rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function profile() {
      return get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      ).data;
    }

    function activeUser() {
      return signedIn()
        && profile().active == true;
    }

    function integrationUser() {
      return activeUser()
        && profile().role == "integration";
    }

    function adminUser() {
      return activeUser()
        && profile().role == "admin";
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function importedEstimateIsPreserved(roleName) {
      return resource.data.estimateSources.get(roleName, null) != "team_poker"
        || (
          request.resource.data.estimateSources.get(roleName, null)
            == resource.data.estimateSources.get(roleName, null)
          && request.resource.data.estimates.get(roleName, null)
            == resource.data.estimates.get(roleName, null)
          && request.resource.data.estimateVersions.get(roleName, null)
            == resource.data.estimateVersions.get(roleName, null)
        );
    }

    function manualTaskRenameOnly() {
      return resource.data.get("source", "")
          == "team_calculator"
        && request.resource.data.get("source", "")
          == "team_calculator"
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["title", "updatedAt"])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 300
        && request.resource.data.updatedAt is string;
    }

    function manualEstimateUpdateOnly() {
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            "estimates",
            "estimateSources",
            "estimateVersions",
            "updatedAt"
          ])
        && request.resource.data.estimates is map
        && request.resource.data.estimateSources is map
        && request.resource.data.estimateVersions is map
        && request.resource.data.updatedAt is string
        && importedEstimateIsPreserved("backend")
        && importedEstimateIsPreserved("frontend");
    }

    function planningUpdateOnly() {
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            "plannedSprintId",
            "plannedSprintName",
            "plannedByUid",
            "plannedByName",
            "planningStatus",
            "carryover",
            "updatedAt"
          ])
        && request.resource.data.updatedAt is string
        && request.resource.data.get("planningStatus", "")
          in ["available", "planned", "completed"]
        && (
          request.resource.data.get("plannedSprintId", null) == null
          || request.resource.data.get("plannedSprintId", null) is string
        )
        && (
          request.resource.data.get("plannedSprintName", null) == null
          || request.resource.data.get("plannedSprintName", null) is string
        )
        && (
          request.resource.data.get("plannedByUid", null) == null
          || request.resource.data.get("plannedByUid", null) is string
        )
        && (
          request.resource.data.get("plannedByName", null) == null
          || request.resource.data.get("plannedByName", null) is string
        )
        && (
          request.resource.data.get("carryover", null) == null
          || request.resource.data.get("carryover", null) is map
        );
    }

    match /users/{userId} {
      // Профили создаются администратором вручную.
      allow create, delete: if false;

      allow read: if isOwner(userId);

      // Обычный пользователь может менять только свой псевдоним.
      allow update: if isOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['alias', 'updatedAt'])
        && request.resource.data.email == resource.data.email
        && request.resource.data.role == resource.data.role
        && request.resource.data.active == resource.data.active;

      match /app/{documentId} {
        allow read, write: if isOwner(userId);
      }

      match /sprints/{sprintId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Общий пул задач Team_calculator.
    match /workspaces/{workspaceId} {
      allow read: if activeUser();
      allow create, update: if adminUser();
      allow delete: if false;

      match /taskPool/{taskId} {
        allow read: if activeUser();

        // Задачи из Team_poker создаёт технический пользователь.
        // Обычный активный пользователь может добавить ручную задачу
        // только от своего имени и только с источником team_calculator.
        allow create: if integrationUser()
          || (
            activeUser()
            && !integrationUser()
            && request.resource.data.id == taskId
            && request.resource.data.source == "team_calculator"
            && request.resource.data.createdByUid == request.auth.uid
          );

        // Интеграция обновляет данные Team_poker.
        // Обычный активный пользователь может переименовать ручную задачу,
        // изменить разрешённые ручные оценки или ограниченный набор полей
        // планирования. Импортированные Backend/Frontend-оценки защищены.
        allow update: if integrationUser()
          || (
            activeUser()
            && !integrationUser()
            && (
              manualTaskRenameOnly()
              || manualEstimateUpdateOnly()
              || planningUpdateOnly()
            )
          );

        allow delete: if activeUser() && !integrationUser();
      }


      match /settings/{settingId} {
        allow read: if activeUser();
        allow create, update: if activeUser()
          && !integrationUser()
          && settingId == "actualCalculation"
          && request.resource.data.schemaVersion in [1, 2]
          && request.resource.data.enabled is bool
          && request.resource.data.timezone is string
          && request.resource.data.workdayStart is string
          && request.resource.data.hoursPerDay is number
          && request.resource.data.excludeWeekends is bool
          && request.resource.data.roundingStep is number
          && request.resource.data.mappings is list
          && request.resource.data.mappings.size() > 0
          && request.resource.data.mappings.size() <= 30
          && (
            request.resource.data.schemaVersion == 1
            || (
              request.resource.data.assigneeTimezones is list
              && request.resource.data.assigneeTimezones.size() <= 200
            )
          );
        allow delete: if false;
      }

      // Очередь запросов к корпоративному GitLab.
      // Браузер не пишет сюда напрямую: задание создаёт Cloudflare Worker
      // под техническим пользователем integration.
      match /gitlab_jobs/{jobId} {
        allow read: if activeUser();

        allow create: if integrationUser()
          && request.resource.data.schemaVersion == 1
          && request.resource.data.status == "pending"
          && request.resource.data.idempotencyKey == jobId
          && request.resource.data.workspaceId == workspaceId
          && (
            (
              request.resource.data.type
                == "sync_gitlab_issue_metadata"
              && request.resource.data.tasks is list
              && request.resource.data.tasks.size() > 0
              && request.resource.data.tasks.size() <= 100
            )
            ||
            (
              request.resource.data.type
                == "sync_gitlab_estimate"
              && request.resource.data.taskId is string
              && request.resource.data.externalTaskUrl is string
              && request.resource.data.estimatedRole
                in ["analytics", "design", "qa", "devops"]
              && request.resource.data.finalEstimate is number
              && request.resource.data.finalEstimate > 0
              && request.resource.data.estimateVersion is number
              && request.resource.data.estimateVersion >= 1
            )
            ||
            (
              request.resource.data.type
                == "calculate_gitlab_actual_preview"
              && request.resource.data.sprintId is string
              && request.resource.data.periodStart is string
              && request.resource.data.periodEnd is string
              && request.resource.data.tasks is list
              && request.resource.data.tasks.size() > 0
              && request.resource.data.tasks.size() <= 100
              && request.resource.data.mappings is list
              && request.resource.data.mappings.size() > 0
              && request.resource.data.mappings.size() <= 30
            )
          );

        // Коннектор использует серверные IAM-права и не ограничен Rules.
        allow update, delete: if false;
      }
    }
  }
}

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function profile() {
      return get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      ).data;
    }

    function activeUser() {
      return signedIn()
        && profile().active == true;
    }

    function integrationUser() {
      return activeUser()
        && profile().role == "integration";
    }

    function adminUser() {
      return activeUser()
        && profile().role == "admin";
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function importedEstimateIsPreserved(roleName) {
      return resource.data.estimateSources.get(roleName, null) != "team_poker"
        || (
          request.resource.data.estimateSources.get(roleName, null)
            == resource.data.estimateSources.get(roleName, null)
          && request.resource.data.estimates.get(roleName, null)
            == resource.data.estimates.get(roleName, null)
          && request.resource.data.estimateVersions.get(roleName, null)
            == resource.data.estimateVersions.get(roleName, null)
        );
    }

    function manualTaskRenameOnly() {
      return resource.data.get("source", "")
          == "team_calculator"
        && request.resource.data.get("source", "")
          == "team_calculator"
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["title", "updatedAt"])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 300
        && request.resource.data.updatedAt is string;
    }

    function manualEstimateUpdateOnly() {
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            "estimates",
            "estimateSources",
            "estimateVersions",
            "updatedAt"
          ])
        && request.resource.data.estimates is map
        && request.resource.data.estimateSources is map
        && request.resource.data.estimateVersions is map
        && request.resource.data.updatedAt is string
        && importedEstimateIsPreserved("backend")
        && importedEstimateIsPreserved("frontend");
    }

    function planningUpdateOnly() {
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            "plannedSprintId",
            "plannedSprintName",
            "plannedByUid",
            "plannedByName",
            "planningStatus",
            "carryover",
            "updatedAt"
          ])
        && request.resource.data.updatedAt is string
        && request.resource.data.get("planningStatus", "")
          in ["available", "planned", "completed"]
        && (
          request.resource.data.get("plannedSprintId", null) == null
          || request.resource.data.get("plannedSprintId", null) is string
        )
        && (
          request.resource.data.get("plannedSprintName", null) == null
          || request.resource.data.get("plannedSprintName", null) is string
        )
        && (
          request.resource.data.get("plannedByUid", null) == null
          || request.resource.data.get("plannedByUid", null) is string
        )
        && (
          request.resource.data.get("plannedByName", null) == null
          || request.resource.data.get("plannedByName", null) is string
        )
        && (
          request.resource.data.get("carryover", null) == null
          || request.resource.data.get("carryover", null) is map
        );
    }

    match /users/{userId} {
      // Профили создаются администратором вручную.
      allow create, delete: if false;

      allow read: if isOwner(userId);

      // Обычный пользователь может менять только свой псевдоним.
      allow update: if isOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['alias', 'updatedAt'])
        && request.resource.data.email == resource.data.email
        && request.resource.data.role == resource.data.role
        && request.resource.data.active == resource.data.active;

      match /app/{documentId} {
        allow read, write: if isOwner(userId);

        // v23.4.61: versioned parts of the local current-state backup.
        match /statePayloadChunks/{chunkId} {
          allow read, create, delete: if isOwner(userId);
          allow update: if false; // Immutable parts
        }
      }

      match /sprints/{sprintId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Общий пул задач Team_calculator.
    match /workspaces/{workspaceId} {
      allow read: if activeUser();
      allow create, update: if adminUser();
      allow delete: if false;

      // Shared sprints: owner or admin may edit, every active user may read.
      match /sprints/{sprintId} {
        allow read: if activeUser();
        allow create: if activeUser() && !integrationUser()
          && request.resource.data.createdByUid == request.auth.uid;
        allow update: if activeUser() && !integrationUser()
          && (adminUser() || resource.data.createdByUid == request.auth.uid)
          && request.resource.data.createdByUid == resource.data.createdByUid;
        allow delete: if activeUser() && !integrationUser()
          && (adminUser() || resource.data.createdByUid == request.auth.uid);

        // Chunks are staged before publishing the parent sprint revision.
        match /payloadChunks/{chunkId} {
          allow read: if activeUser();
          allow create: if activeUser() && !integrationUser()
            && request.resource.data.ownerUid == request.auth.uid
            && request.resource.data.revision is string
            && request.resource.data.index is int
            && request.resource.data.data is string
            && (
              !exists(/databases/$(database)/documents/workspaces/$(workspaceId)/sprints/$(sprintId))
              || adminUser()
              || get(/databases/$(database)/documents/workspaces/$(workspaceId)/sprints/$(sprintId)).data.createdByUid == request.auth.uid
            );
          allow update: if false;
          allow delete: if activeUser() && !integrationUser()
            && (adminUser() || resource.data.ownerUid == request.auth.uid);
        }
      }

      match /taskPool/{taskId} {
        allow read: if activeUser();

        // Задачи из Team_poker создаёт технический пользователь.
        // Обычный активный пользователь может добавить ручную задачу
        // только от своего имени и только с источником team_calculator.
        allow create: if integrationUser()
          || (
            activeUser()
            && !integrationUser()
            && request.resource.data.id == taskId
            && request.resource.data.source == "team_calculator"
            && request.resource.data.createdByUid == request.auth.uid
          );

        // Интеграция обновляет данные Team_poker.
        // Обычный активный пользователь может переименовать ручную задачу,
        // изменить разрешённые ручные оценки или ограниченный набор полей
        // планирования. Импортированные Backend/Frontend-оценки защищены.
        allow update: if integrationUser()
          || (
            activeUser()
            && !integrationUser()
            && (
              manualTaskRenameOnly()
              || manualEstimateUpdateOnly()
              || planningUpdateOnly()
            )
          );

        allow delete: if activeUser() && !integrationUser();
      }


      match /settings/{settingId} {
        allow read: if activeUser();
        allow create, update: if activeUser()
          && !integrationUser()
          && settingId == "actualCalculation"
          && request.resource.data.schemaVersion in [1, 2]
          && request.resource.data.enabled is bool
          && request.resource.data.timezone is string
          && request.resource.data.workdayStart is string
          && request.resource.data.hoursPerDay is number
          && request.resource.data.excludeWeekends is bool
          && request.resource.data.roundingStep is number
          && request.resource.data.mappings is list
          && request.resource.data.mappings.size() > 0
          && request.resource.data.mappings.size() <= 30
          && (
            request.resource.data.schemaVersion == 1
            || (
              request.resource.data.assigneeTimezones is list
              && request.resource.data.assigneeTimezones.size() <= 200
            )
          );
        allow delete: if false;
      }

      // Очередь запросов к корпоративному GitLab.
      // v23.4.63: разрешены только Unexpected и legacy-запрос unexpected
      // одновременно с назначением Iteration для сохранённой внеплановой задачи.
      // Hotfix: прямые запросы браузера разрешены для активного пользователя
      // с проверкой автора, начального состояния и конкретного типа задания.
      match /gitlab_jobs/{jobId} {
        function unexpectedMatchesSavedSprint(job, task) {
          let sprint = get(/databases/$(database)/documents/workspaces/$(workspaceId)/sprints/$(job.sprintId)).data;
          let pool = get(/databases/$(database)/documents/workspaces/$(workspaceId)/taskPool/$(task.taskId)).data;
          return (adminUser() || sprint.createdByUid == request.auth.uid)
            && sprint.input.sprintLifecycleStatus == "active"
            && sprint.input.sprintBaseline.selectedTaskIds is list
            && task.taskId in sprint.input.selectedTaskIds
            && !(task.taskId in sprint.input.sprintBaseline.selectedTaskIds)
            && !(task.taskId in sprint.input.get("sprintReturnedTaskIds", []))
            && job.iterationMutation.iterationId == sprint.input.sprintGitLabIteration.id
            && job.iterationMutation.iterationTitle == sprint.input.sprintGitLabIteration.title
            && pool.plannedSprintId == job.sprintId
            && (pool.externalTaskUrl == task.externalTaskUrl
              || pool.externalTaskUrl == task.externalTaskUrl + "/");
        }

        function unexpectedAssignmentAllowed(job) {
          return activeUser() && !integrationUser()
            && job.requestedByUid == request.auth.uid
            && job.type == "sync_gitlab_issue_metadata"
            && job.sprintLifecycleStatus == "active"
            && job.sprintId is string
            && job.sprintId.size() > 0
            && job.tasks is list && job.tasks.size() == 1
            && job.tasks[0].taskId is string && job.tasks[0].taskId.size() > 0
            && job.tasks[0].externalTaskUrl is string
            && job.tasks[0].keys().hasOnly(["taskId", "title", "externalTaskUrl"])
            && job.get("iterationMutation", {}) is map
            && job.iterationMutation.keys().hasOnly(["mode", "iterationId", "iterationTitle", "addLabels"])
            && job.iterationMutation.mode == "set"
            && (job.iterationMutation.addLabels == ["Unexpected"]
              || job.iterationMutation.addLabels == ["unexpected"])
            && job.iterationMutation.iterationId is int && job.iterationMutation.iterationId > 0
            && job.iterationMutation.iterationTitle is string
            && job.iterationMutation.iterationTitle.size() > 0
            && job.keys().hasOnly([
              "schemaVersion", "status", "idempotencyKey", "clientRequestId", "workspaceId",
              "requestedByUid", "requestedByEmail", "requestedByDisplayName", "requestedAt",
              "updatedAt", "attempts", "processedCount", "succeededCount", "failedCount",
              "type", "sprintId", "sprintName", "sprintLifecycleStatus", "tasks",
              "statusLabels", "iterationMutation"
            ])
            && job.attempts == 0 && job.processedCount == 0
            && job.succeededCount == 0 && job.failedCount == 0
            && unexpectedMatchesSavedSprint(job, job.tasks[0]);
        }

        // v23.4.62 hotfix: the web client has queued jobs directly since v23.4.33.
        function browserJobEnvelope(job) {
          return activeUser() && !integrationUser()
            && job.requestedByUid == request.auth.uid
            && job.requestedByEmail == request.auth.token.get("email", "")
            && job.requestedByDisplayName is string
            && job.clientRequestId is string && job.clientRequestId.size() > 0
            && job.requestedAt is string && job.updatedAt is string
            && job.attempts == 0 && job.processedCount == 0
            && job.succeededCount == 0 && job.failedCount == 0;
        }

        function browserJobKeys(job, extraKeys) {
          return job.keys().hasOnly([
            "schemaVersion", "status", "idempotencyKey", "clientRequestId", "workspaceId",
            "requestedByUid", "requestedByEmail", "requestedByDisplayName", "requestedAt",
            "updatedAt", "attempts", "processedCount", "succeededCount", "failedCount", "type"
          ].concat(extraKeys));
        }

        function poolUrlMatches(pool, url) {
          return url is string && url.size() > 0
            && (pool.externalTaskUrl == url || pool.externalTaskUrl == url + "/");
        }

        function editableSavedSprint(sprintId) {
          return adminUser() || get(/databases/$(database)/documents/workspaces/$(workspaceId)/sprints/$(sprintId)).data.createdByUid == request.auth.uid;
        }

        function regularIterationMatchesPool(job, task) {
          let pool = get(/databases/$(database)/documents/workspaces/$(workspaceId)/taskPool/$(task.taskId)).data;
          let mutation = job.iterationMutation;
          return poolUrlMatches(pool, task.externalTaskUrl)
            && (
              (mutation.mode == "clear"
                && mutation.iterationId == null && mutation.iterationTitle == null
                && pool.get("plannedSprintId", null) == null)
              || (mutation.mode == "set"
                && job.sprintLifecycleStatus in ["planning", "active"]
                && mutation.iterationId is int && mutation.iterationId > 0
                && mutation.iterationTitle is string && mutation.iterationTitle.size() > 0
                && ((job.sprintId == null && pool.get("plannedSprintId", null) == null
                    && job.sprintLifecycleStatus == "planning")
                  || (job.sprintId is string && job.sprintId.size() > 0
                    && pool.get("plannedSprintId", null) == job.sprintId
                    && editableSavedSprint(job.sprintId))))
            );
        }

        function browserMetadataAllowed(job) {
          return browserJobKeys(job, ["sprintId", "sprintName", "sprintLifecycleStatus",
              "tasks", "statusLabels", "iterationCatalogRequest", "iterationMutation"])
            && job.sprintLifecycleStatus in ["planning", "active", "completed"]
            && (job.sprintId == null || job.sprintId is string)
            && (job.sprintName == null || job.sprintName is string)
            && job.tasks is list && job.tasks.size() > 0 && job.tasks.size() <= 100
            && job.statusLabels is list && job.statusLabels.size() > 0 && job.statusLabels.size() <= 30
            && (
              (!job.keys().hasAny(["iterationMutation"])
                && job.get("iterationCatalogRequest", false) is bool)
              || (!job.keys().hasAny(["iterationCatalogRequest"])
                && job.tasks.size() == 1 && job.tasks[0] is map
                && job.tasks[0].keys().hasOnly(["taskId", "title", "externalTaskUrl"])
                && job.tasks[0].taskId is string && job.tasks[0].taskId.size() > 0
                && job.iterationMutation is map
                && job.iterationMutation.keys().hasOnly(["mode", "iterationId", "iterationTitle"])
                && regularIterationMatchesPool(job, job.tasks[0]))
              || unexpectedAssignmentAllowed(job)
            );
        }

        function browserEstimateMatchesPool(job) {
          let pool = get(/databases/$(database)/documents/workspaces/$(workspaceId)/taskPool/$(job.taskId)).data;
          return pool.get("source", "") == "team_calculator"
            && poolUrlMatches(pool, job.externalTaskUrl)
            && pool.estimates.get(job.estimatedRole, 0) == job.finalEstimate
            && pool.get("estimateVersions", {}).get(job.estimatedRole, 0) == job.estimateVersion;
        }

        function browserEstimateAllowed(job) {
          return browserJobKeys(job, ["taskId", "issueTitle", "externalTaskUrl", "estimatedRole",
              "finalEstimate", "estimateVersion", "gitlabLabel", "applyLabel", "hoursPerDay", "reason"])
            && job.taskId is string && job.taskId.size() > 0
            && job.estimatedRole in ["analytics", "design", "qa", "devops"]
            && job.finalEstimate is number && job.finalEstimate > 0
            && job.estimateVersion is int && job.estimateVersion >= 1
            && job.gitlabLabel == "estimate::done"
            && job.applyLabel is bool && job.hoursPerDay is number
            && job.hoursPerDay >= 1 && job.hoursPerDay <= 24
            && browserEstimateMatchesPool(job);
        }

        function browserActualAllowed(job) {
          return browserJobKeys(job, ["sprintId", "sprintName", "periodStart", "periodEnd",
              "calendar", "mappings", "settingsSnapshot", "tasks"])
            && job.sprintId is string && job.sprintId.size() > 0
            && job.periodStart is string && job.periodEnd is string
            && job.tasks is list && job.tasks.size() > 0 && job.tasks.size() <= 100
            && job.mappings is list && job.mappings.size() > 0 && job.mappings.size() <= 30
            && job.calendar is map && job.settingsSnapshot is map
            && job.settingsSnapshot.calendar == job.calendar
            && job.settingsSnapshot.mappings == job.mappings;
        }

        function browserJobAllowed(job) {
          return browserJobEnvelope(job)
            && ((job.type == "sync_gitlab_issue_metadata" && browserMetadataAllowed(job))
              || (job.type == "sync_gitlab_estimate" && browserEstimateAllowed(job))
              || (job.type == "calculate_gitlab_actual_preview" && browserActualAllowed(job)));
        }

        allow read: if activeUser();

        allow create: if (integrationUser() || browserJobAllowed(request.resource.data))
          && request.resource.data.schemaVersion == 1
          && request.resource.data.status == "pending"
          && request.resource.data.idempotencyKey == jobId
          && request.resource.data.workspaceId == workspaceId
          && (
            (
              request.resource.data.type
                == "sync_gitlab_issue_metadata"
              && request.resource.data.tasks is list
              && request.resource.data.tasks.size() > 0
              && request.resource.data.tasks.size() <= 100
            )
            ||
            (
              request.resource.data.type
                == "sync_gitlab_estimate"
              && request.resource.data.taskId is string
              && request.resource.data.externalTaskUrl is string
              && request.resource.data.estimatedRole
                in ["analytics", "design", "qa", "devops"]
              && request.resource.data.finalEstimate is number
              && request.resource.data.finalEstimate > 0
              && request.resource.data.estimateVersion is number
              && request.resource.data.estimateVersion >= 1
            )
            ||
            (
              request.resource.data.type
                == "calculate_gitlab_actual_preview"
              && request.resource.data.sprintId is string
              && request.resource.data.periodStart is string
              && request.resource.data.periodEnd is string
              && request.resource.data.tasks is list
              && request.resource.data.tasks.size() > 0
              && request.resource.data.tasks.size() <= 100
              && request.resource.data.mappings is list
              && request.resource.data.mappings.size() > 0
              && request.resource.data.mappings.size() <= 30
            )
          );

        // Коннектор использует серверные IAM-права и не ограничен Rules.
        allow update, delete: if false;
      }
    }
  }
}
